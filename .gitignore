__pycache__/
*.pyc
*.lock
# Lane caches and bulk outputs are rebuilt from code and a data manifest, never committed.
experiments/*/cache/
experiments/*/data/
experiments/*/results/*.npy

/data/
/.venv/
/.cache/
experiments/*/results/*.parquet
experiments/*/results/*.npz

# context-lift lists are hundreds of MB; their sha256 is kept in results/validation_hashes.json
experiments/atlas_ctx/results/*.csv
experiments/atlas_mtf/results/*.csv
.forward.lock
.forward_loop.pid
dashboard/data/
.notices.lock
.notice_loop.pid
# R275's daily rows and trades (61 MB, 19 MB) are rebuilt by its frozen run; their sha256 is in results/hashes.json
experiments/xfund_v1/results/daily.csv
experiments/xfund_v1/results/trades.csv
# R280's list of liquidated legs (40 MB) is rebuilt by its frozen run; its sha256 is in results/hashes.json
experiments/levcarry_v1/results/events.csv
# R290's trade list (6.4 MB) is rebuilt by its frozen run; its sha256 is in results/hashes.json
experiments/auction_v1/results/trades.csv.gz
experiments/vpin_v1/results/hourly.csv.gz
# R306's trade list (12 MB) is rebuilt by its frozen run; its sha256 is in results/hashes.json
experiments/msnr_v1/results/trades.csv.gz

# Reproducible test dependency lock is source, unlike runtime lock files.
!requirements-test.lock

# Compact frozen equation forecasts/attribution are audit evidence, not bulk input caches.
!experiments/equations_v1/results/forecasts.npz
!experiments/equations_v1/results/coin_pnl.npz
!experiments/equations_v2/results/forecasts.npz
!experiments/equations_v2/results/coin_pnl.npz
# R323 raw append-only model journals are preserved locally; immutable packed copies are tracked.
/experiments/continuation_control_v1/.cache/
# R324 native append-only model journals stay local; immutable packed copies are tracked.
/experiments/spot_perp_inputs_v1/model_journals/
# R325 native simulated journals remain append-only locally; packed evidence is tracked.
/experiments/spot_perp_costs_v1/model_journals/
# R326 preserves native journals locally and tracks their immutable packed copy.
/experiments/spot_perp_costs_v2/model_journals/
# R327 native hypothetical coin/spot journals stay append-only locally; compact pack is tracked.
/experiments/dated_carry_v1/model_journals/
/experiments/dated_carry_v2/model_journals/
