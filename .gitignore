*.pyc
*.lock
# Lane caches and bulk outputs are rebuilt from code and a data manifest, never committed.
experiments/*/cache/
experiments/*/data/
experiments/*/results/*.npy

/data/
/.venv/
experiments/*/results/*.parquet
experiments/*/results/*.npz

# context-lift lists are hundreds of MB; their sha256 is kept in results/validation_hashes.json
experiments/atlas_ctx/results/*.csv
experiments/atlas_mtf/results/*.csv
.forward.lock
.forward_loop.pid
dashboard/data/
.notices.lock
.notice_loop.pid
# R275's daily rows and trades (61 MB, 19 MB) are rebuilt by its frozen run; their sha256 is in results/hashes.json
experiments/xfund_v1/results/daily.csv
experiments/xfund_v1/results/trades.csv
